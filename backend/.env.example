# ==============================================================================
# Handwritten Freight Bill OCR - Environment Configuration Template (.env.example)
# Copy this file to '.env' in the backend directory for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OCR Provider Configuration
# ------------------------------------------------------------------------------
# Options:
#   local       — offline OCR (recommended until GCP billing is enabled)
#   document_ai — Google Cloud Document AI (requires billing + processor)
#   mock        — canned freight-bill payload for UI demos without OCR
OCR_PROVIDER=local
USE_MOCK_OCR=false

# Google Cloud Document AI (required when OCR_PROVIDER=document_ai)
# Create a processor in: https://console.cloud.google.com/ai/document-ai
# Recommended: Form Parser or Document OCR processor in the same region.
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your_processor_id_here

# Path to a GCP service-account JSON key. The Google client libraries also
# honor this variable if it is set in the shell instead of this file.
# Example: ./service_account_key.json
GOOGLE_APPLICATION_CREDENTIALS=./service_account_key.json

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Local:
# DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/freight_ocr
#
# Supabase (Settings → Database → URI). Change postgresql:// to postgresql+psycopg://
# and add sslmode=require. Use Session pooler (5432) or Direct connection, not Transaction pooler.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/freight_ocr

# ------------------------------------------------------------------------------
# 3. File & Directory Locations
# ------------------------------------------------------------------------------
INPUT_DOC_LOCATION=./input_doc_location
PROCESSED_DOCUMENTS_LOCATION=./processed_documents
# Local cache of bill PDFs (always written). Relative paths resolve from backend/.
STORAGE_LOCATION=./storage/documents

# Supabase Storage: upload bills to a private bucket so they survive machine/cwd changes.
# Project Settings → API → Project URL and service_role (secret). Never use the anon key.
# SUPABASE_URL is optional when DATABASE_URL is a Supabase pooler URI (project ref is derived).
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=freight-bills

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME=Handwritten Freight Bill OCR
DEBUG=false
TESTING=false

# ------------------------------------------------------------------------------
# 5. Groq LLM (English / Spanish / other high-resource languages)
# ------------------------------------------------------------------------------
# Maps OCR text onto freight JSON. Vision reads the page image (handwriting).
# Get a free key: https://console.groq.com
ENABLE_GROQ=true
ENABLE_GROQ_VISION=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Current Groq vision+JSON model. Fallback: meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MAX_PAGES=2
# Keep this low: Groq on-demand vision ITPM is 7000. Three 1536px images request ~7070.
GROQ_VISION_MAX_EDGE=1024
# Point 7: use Groq Vision only for uncertain fields after deterministic extraction.
GROQ_VISION_FALLBACK_ENABLED=true
GROQ_VISION_FALLBACK_MAX_FIELDS=8
GROQ_VISION_FALLBACK_MIN_CONFIDENCE=0.80
GROQ_VISION_AMBIGUITY_MAX_GAP=0.08

# Snap OCR names to known companies/drivers and fix 0/O, 9/& glyph swaps.
# Review corrections grow gazetteer.json (names, aliases, streets-by-ZIP).
# Reviewed tickets also rebuild priors.json (entity/route co-occurrence counts).
# ZIP→city uses a regional table plus learned ZIPs — not a full USPS street dump.
ENABLE_ENTITY_MATCHING=true
# Top-K entity candidates kept alongside 1-best gazetteer matching (Point 2).
CANDIDATE_TOP_K=5
# Bounded beam for Point 3 joint decoding. Selected entity fields are applied
# with an OCR-guard so a much stronger gazetteer/OCR hit is not overwritten.
DECODE_BEAM_WIDTH=8
DECODE_MAX_PER_FIELD=4
DECODE_APPLY_SELECTED=true
# When OCR for a field is empty/junk, inject top route-conditioned prior names.
PRIOR_INJECT_WHEN_OCR_WEAK=true
PRIOR_INJECT_MIN_COUNT=1
PRIOR_INJECT_MAX=5
# Fill the 4th party field when 3 of 4 are resolved and the route prior is peaked.
PRIOR_FILL_MIN_COUNT=3
PRIOR_FILL_MIN_PROBABILITY=0.80
# Point 4 calibration: isotonic fit requires enough accept AND reject labels per field.
# Below these counts the existing heuristic field confidence is used unchanged.
CALIBRATION_MIN_SAMPLES=20
CALIBRATION_MIN_POSITIVES=3
CALIBRATION_MIN_NEGATIVES=3
# Auto-post thresholds (calibrated P(correct) must meet the field's bar).
# Numeric/financial (weight, total, rate, amounts): tighter.
# Handwritten names (consignee, consignor, driver, places): looser.
# Other fields use the default. REVIEW is only forced when a field was actually calibrated.
CONFIDENCE_THRESHOLD_DEFAULT=0.80
CONFIDENCE_THRESHOLD_NUMERIC=0.90
CONFIDENCE_THRESHOLD_NAME=0.70
# Point 5 consistency checks (analysis only; does not overwrite extracted fields).
# Line-item rounding tolerance matches the existing $0.05 validator.
CONSISTENCY_LINE_ITEM_TOLERANCE=0.05
# Historical conflict requires a strong usual value; sparse priors do not warn.
CONSISTENCY_PRIOR_MIN_COUNT=3
CONSISTENCY_PRIOR_MIN_PROBABILITY=0.70
CONSISTENCY_PRIOR_WEAK_PROBABILITY=0.20

